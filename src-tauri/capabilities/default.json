{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and module alert windows",
  "windows": [
    "main",
    "module-alert"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "opener:default",
    "allow-open-external",
    "allow-greet"
  ]
}
